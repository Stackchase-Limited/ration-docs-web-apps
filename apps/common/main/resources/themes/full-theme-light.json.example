{
    "name": "Full light theme",
    "l10n": {
        "fr": "Thème pleine lumière",
        "de": "Volledig licht thema"
      },
    "id" : "theme-id-full-light",
    "type" : "light",
    "colors" : {
        "toolbar-header-document": "#446995",
        "toolbar-header-spreadsheet": "#40865c",
